# Chain RPC (to read settlement events)
ZENA_RPC_URL=http://localhost:8545
ZENA_CHAIN_ID=1337

# Settlement contract address (deployed to devnet in Phase 3)
SETTLE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Payment partner – sandbox credentials only
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_WEBHOOK_SECRET=whsec_placeholder

# Idempotency – PostgreSQL for the append-only ledger
DATABASE_URL=postgresql://zena:zena@localhost:5432/zena_settle_dev

