    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@vitest/coverage-v8": "*",
    "hardhat": "^2.29.1",
    "typescript": "*",
    "vitest": "*"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
