{
  "name": "@zena/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zena smart contracts — Solidity source for event registry, dual-signed handover, settlement, governance, and membership. Targets Hyperledger Besu (EVM-compatible).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "compile": "hardhat compile",
    "build": "hardhat compile && tsc --project tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test && vitest run --coverage --dir src",
    "test:contracts": "hardhat test",
    "test:unit": "vitest run --coverage --dir src",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.0.2",
    "@types/chai": "^4",
    "@types/mocha": "^10.0.10",
    "@vitest/coverage-v8": "*",
    "chai": "^4.5.0",
    "hardhat": "^2.22.0",
    "solc": "0.8.24",
    "typescript": "*",
    "vitest": "*"
  }
}
