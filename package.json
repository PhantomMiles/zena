{
  "name": "zena",
  "private": true,
  "version": "0.0.0",
  "description": "Zena Network – decentralised logistics network. One record. Every carrier.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "prepare": "husky",
    "pwa": "node pwa/serve.js",
    "devnet:generate": "node --experimental-strip-types infra/devnet/scripts/generate.ts",
    "devnet:up": "docker compose -f infra/devnet/docker-compose.yml up -d",
    "devnet:down": "docker compose -f infra/devnet/docker-compose.yml down",
    "devnet:reset": "node --experimental-strip-types infra/devnet/scripts/generate.ts",
    "devnet:health": "node --experimental-strip-types infra/devnet/scripts/health.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "ethers": "^6.17.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
